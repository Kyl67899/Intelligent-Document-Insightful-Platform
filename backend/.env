# ---------------------------------------------------------------------------
# Flask core
# ---------------------------------------------------------------------------
FLASK_APP=app.py
FLASK_ENV=development
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5050
SECRET_KEY=58a79e673c59a09104f2f650d0f24fcbd9aaeae04015d990e88a276371dc9f09
DEBUG=True

# ---------------------------------------------------------------------------
# Database (SQLite by default for local/demo use; swap for Postgres in prod)
# e.g. postgresql://user:password@localhost:5432/idip
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///idip.db

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=d69582c5a15fc819f5d2ba3d235a0a7b00228598a8daabce864acaefdb29e53d
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7
SESSION_COOKIE_SECURE=False

# ---------------------------------------------------------------------------
# CORS - the origin(s) your Next.js frontend runs on
# ---------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000
PORT=5050

# ---------------------------------------------------------------------------
# File storage
# LOCAL storage writes to ./uploads. Set STORAGE_BACKEND=s3 to use S3-compatible
# cloud storage instead (requires the boto3-related vars below).
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=25

# Optional cloud storage (only used when STORAGE_BACKEND=s3)
S3_BUCKET_NAME=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# LLM provider (Anthropic Claude) - used for summarization, insight
# extraction, and answer generation in the QA endpoint
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=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
LLM_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Vector database (Chroma, persisted locally to disk)
# ---------------------------------------------------------------------------
CHROMA_PERSIST_DIR=chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
